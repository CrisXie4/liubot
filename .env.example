# ============================================
# QQ Bot 配置文件
# 复制此文件为 .env 并修改配置
# ============================================

# --- NapCatQQ OneBot 连接 ---
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_HTTP_URL=http://127.0.0.1:3000
NAPCAT_HTTP_TOKEN=your_http_token_here
NAPCAT_WS_TOKEN=your_ws_token_here

# --- Bot 身份 ---
BOT_QQ=你的BotQQ号
OWNER_QQ=你的QQ号

# --- AI 大模型 ---
LLM_API_KEY=your_api_key_here
LLM_API_URL=https://api.ccode.vip
LLM_MODEL=gemini-3.5-flash-free
# 主模型不可用时自动降级到这个模型（在 llm_call.llm_create 中处理）
LLM_FALLBACK_MODEL=minimax-m3-free
# 图片审核 / 图片理解专用模型（必须支持 vision 输入）
LLM_VISION_MODEL=minimax-m3-free
# 额外 provider 注入（JSON 数组，可留空）——加渠道只改 .env，不用动 data/
# 普通模式：env 渠道排在 JSON 渠道前面（supports_vision=true 即首选视觉渠道）
# 条目字段：api_url / api_key / model / supports_vision / max_context_tokens（可选，渠道窗口上限）
#          thinking_effort（可选，low/medium/high/xhigh/max，开启思考模式）
#          —— DeepSeek effort 映射：low→low, medium/high/xhigh→high, max→max
# 示例 1：DeepSeek 官方 Anthropic 兼容端点（视觉 + 1M 上下文 + 思考）：
# LLM_EXTRA_PROVIDERS=[{"api_url":"https://api.deepseek.com/anthropic","api_key":"sk-xxx","model":"deepseek-v4-flash-vision-exp","supports_vision":true,"max_context_tokens":1000000,"thinking_effort":"high"}]
# 示例 2：免密钥 llama.cpp 公共端点（9B 多模态，图像识别效果好，Anthropic/OpenAI 协议均兼容）：
# LLM_EXTRA_PROVIDERS=[{"api_url":"https://bigmodel.d1kt.cn","api_key":"no-key","model":"models/Qwythos-9B-Claude-Mythos-5-1M-MTP-Q5_K_M.gguf","supports_vision":true,"max_context_tokens":24000}]
LLM_EXTRA_PROVIDERS=
# 独占模式：true = 只用上面注入的渠道，默认渠道（LLM_API_URL）和 data/ 的 JSON 渠道全部停用
LLM_PROVIDERS_EXCLUSIVE=false

# --- Web 控制面板 ---
WEB_HOST=127.0.0.1
WEB_PORT=8090
WEB_PASSWORD=修改此密码

# --- 审核 ---
LLM_MOD_ENABLED=true

# --- Web 安全 ---
SECRET_KEY=
JWT_EXPIRES_HOURS=24
WEB_ALLOWED_IPS=

# --- 网站认证（加群验证网站模式，留空则降级放行）---
# 从 https://dash.cloudflare.com → Turnstile 获取
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 网站认证模式触发概率（0-100，默认 50；0=全出题，100=全网站）
WEB_VERIFY_RATIO=50

# --- Bot 行为 ---
BOT_NAME=小Q
AUTO_ACCEPT_INVITE=false
CHAT_CONTEXT_SIZE=10
AUTO_MOD_ENABLED=true

# --- 中转站数据库（Neon Postgres，AI 只读查询/主人可改，留空不启用） ---
RELAY_DB_URL=postgresql://user:password@host/dbname?sslmode=require
