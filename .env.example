# ============================================
# QQ Bot 配置文件
# 复制此文件为 .env 并修改配置
# ============================================

# --- NapCatQQ OneBot 连接 ---
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_HTTP_URL=http://127.0.0.1:3000
NAPCAT_HTTP_TOKEN=your_http_token_here
NAPCAT_WS_TOKEN=your_ws_token_here

# --- Bot 身份 ---
BOT_QQ=你的BotQQ号
OWNER_QQ=你的QQ号

# --- AI 大模型 ---
LLM_API_KEY=your_api_key_here
LLM_API_URL=https://api.minimaxi.com/anthropic
LLM_MODEL=MiniMax-M3

# --- Web 控制面板 ---
WEB_HOST=127.0.0.1
WEB_PORT=8090
WEB_PASSWORD=修改此密码

# --- 审核 ---
LLM_MOD_ENABLED=true

# --- Web 安全 ---
SECRET_KEY=
JWT_EXPIRES_HOURS=24
WEB_ALLOWED_IPS=

# --- Bot 行为 ---
BOT_NAME=小Q
AUTO_ACCEPT_INVITE=false
CHAT_CONTEXT_SIZE=10
AUTO_MOD_ENABLED=true
